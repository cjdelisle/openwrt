#include <dt-bindings/reset/econet,en751221-scu.h>

/dts-v1/;

/ {
	compatible = "econet,en751221";
	#address-cells = <1>;
	#size-cells = <1>;

	hpt_clock: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;  /* 200 MHz */
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,mips34Kc";
			reg = <0>;
		};
	};

	cpuintc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		interrupt-controller;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	spi_ctrl: spi_controller@1fa10000 {
		compatible = "airoha,en7523-spi";
		reg = <0x1fa10000 0x140>;
		#address-cells = <1>;
		#size-cells = <0>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;

		nand: nand@0 {
			compatible = "spi-nand";
			reg = <0>;
			nand-ecc-engine = <&nand>;
		};
	};

	chip_scu: syscon@1fa20000 {
		compatible = "econet,en751221-chip-scu", "syscon";
		reg = <0x1fa20000 0x388>;
	};

	intc: interrupt-controller@1fb40000 {
		compatible = "econet,en751221-intc";
		reg = <0x1fb40000 0x100>;
		interrupt-parent = <&cpuintc>;
		interrupts = <2>;

		interrupt-controller;
		#interrupt-cells = <1>;
		econet,shadow-interrupts = <7 2>, <8 3>, <13 12>, <30 29>;
	};

	scuclk: clock-controller@1fb00000 {
		compatible = "econet,en751221-scu", "syscon";
		reg = <0x1fb00000 0x970>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	ethernet: ethernet@1fb50000 {
		compatible = "econet,en751221-eth";
		reg = <0x1fb50000 0x8000>;

		resets = <&scuclk EN751221_FE_RST>,
			 <&scuclk EN751221_FE_QDMA1_RST>,
			 <&scuclk EN751221_FE_QDMA2_RST>,
			 <&scuclk EN751221_XPON_MAC_RST>,
			 <&scuclk EN751221_XPON_PHY_RST>;
		reset-names = "fe", "qdma0", "qdma1",
			      "xpon-mac", "xpon-phy";

		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&intc>;
		interrupts = <21>, <22>;

		gmac0: mac@0 {
			compatible = "econet,eth-mac";
			reg = <0>;
			phy-mode = "trgmii";
			status = "disabled";

			fixed-link {
				speed = <1000>;
				full-duplex;
				pause;
			};
		};

		gmac1: mac@1 {
			compatible = "econet,eth-mac";
			reg = <1>;
			status = "disabled";
			phy-mode = "rgmii-rxid";
		};
	};

	switch0: switch@1fb58000 {
		compatible = "econet,en751221-switch";
		reg = <0x1fb58000 0x8000>;

		resets = <&scuclk EN751221_GSW_RST>;
		reset-names = "gsw";

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&intc>;
		interrupts = <15>;

		#address-cells = <1>;
		#size-cells = <0>;

		dsa,member = <0 0>;

		ports {
			switch0port0: port@0 {
				reg = <0>;
				phy-handle = <&switch0phy0>;
				status = "disabled";
			};

			switch0port1: port@1 {
				reg = <1>;
				phy-handle = <&switch0phy1>;
				status = "disabled";
			};

			switch0port2: port@2 {
				reg = <2>;
				phy-handle = <&switch0phy2>;
				status = "disabled";
			};

			switch0port3: port@3 {
				reg = <3>;
				phy-handle = <&switch0phy3>;
				status = "disabled";
			};

			switch0port4: port@4 {
				reg = <4>;
				phy-handle = <&switch0phy4>;
				status = "disabled";
			};

			switch0port5: port@5 {
				reg = <5>;
				phy-mode = "rgmii";
				link = <&switch1port6>;
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			switch0port6: port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "internal";
				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			switch1phy0: ethernet-phy@0 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <0>;
				interrupts = <0>;
			};

			switch1phy1: ethernet-phy@1 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <1>;
			};

			switch1phy2: ethernet-phy@2 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <2>;
			};

			switch1phy3: ethernet-phy@3 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <3>;
			};

			switch1phy4: ethernet-phy@4 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <4>;
			};

			switch0phy0: ethernet-phy@8 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <8>;
			};

			switch0phy1: ethernet-phy@9 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <9>;
			};

			switch0phy2: ethernet-phy@10 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <10>;
			};

			switch0phy3: ethernet-phy@11 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <11>;
			};

			switch0phy4: ethernet-phy@12 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <12>;
			};

			switch1: switch@31 {
				compatible = "econet,en751221-switch";
				reg = <31>;

				resets = <&scuclk EN751221_MCM_GSW_RST>;
				reset-names = "mcm";

				dsa,member = <0 1>;
				mediatek,mcm;

				ports {
					switch1port0: port@0 {
						reg = <0>;
						phy-handle = <&switch1phy0>;
						status = "disabled";
					};

					switch1port1: port@1 {
						reg = <1>;
						phy-handle = <&switch1phy1>;
						status = "disabled";
					};

					switch1port2: port@2 {
						reg = <2>;
						phy-handle = <&switch1phy2>;
						status = "disabled";
					};

					switch1port3: port@3 {
						reg = <3>;
						phy-handle = <&switch1phy3>;
						status = "disabled";
					};

					switch1port4: port@4 {
						reg = <4>;
						phy-handle = <&switch1phy4>;
						status = "disabled";
					};

					switch1port5: port@5 {
						reg = <5>;
						phy-mode = "rgmii";
						status = "disabled";
						fixed-link {
							speed = <1000>;
							full-duplex;
						};
					};

					switch1port6: port@6 {
						reg = <6>;
						link = <&switch0port5>;
						phy-mode = "trgmii";
						fixed-link {
							speed = <1000>;
							full-duplex;
						};
					};
				};
			};

		};
	};

    usb: usb@1fb90000 {
            compatible = "mediatek,mt8173-xhci", "mediatek,mtk-xhci";
            reg = <0x1fb90000 0x4000>,
                  <0x1fa80700 0x100>;
            reg-names = "mac", "ippc";

            #address-cells = <1>;
            #size-cells = <0>;

            interrupt-parent = <&intc>;
            interrupts = <17>;
            usb3-lpm-capable;
    };

	uart: serial@1fbf0000 {
		compatible = "ns16550";
		reg = <0x1fbf0000 0x30>;
		reg-io-width = <4>;
		reg-shift = <2>;
		interrupt-parent = <&intc>;
		interrupts = <0>;
		/*
		 * Conversion of baud rate to clock frequency requires a
		 * computation that is not in the ns16550 driver, so this
		 * uart is fixed at 115200 baud.
		 */
		clock-frequency = <1843200>;
	};

	timer_hpt: timer@1fbf0400 {
		compatible = "econet,en751221-timer";
		reg = <0x1fbf0400 0x100>;

		interrupt-parent = <&intc>;
		interrupts = <30>;
		clocks = <&hpt_clock>;
	};
};
